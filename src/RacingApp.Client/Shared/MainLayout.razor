        <div class="brand">Racing<span>App</span></div>
        <nav>
            <NavLink href="" Match="NavLinkMatch.All">Schedule</NavLink>
            <AuthorizeView Context="auth" Roles="TrackAdmin,StableAdmin,Owner,Trainer,Handler,Vet">
                <NavLink href="racers">Racers</NavLink>
            </AuthorizeView>
            <AuthorizeView Context="auth" Roles="Owner,Trainer,Handler">
