@page "/register"

<h1>Register</h1>

<div class="card" style="max-width:420px">
    <p>Public registration creates a <strong>Racegoer</strong> account. Owner, trainer, vet and track admin accounts are provisioned by the track.</p>
    @if (error is not null)
    {
        <div class="alert-error">@error</div>
    }
    <EditForm Model="model" OnValidSubmit="Submit">
        <DataAnnotationsValidator />
        <label>Full name</label>
        <InputText @bind-Value="model.FullName" />
        <label>Email</label>
        <InputText @bind-Value="model.Email" />
        <label>Password</label>
        <InputText type="password" @bind-Value="model.Password" />
        <button type="submit" disabled="@busy">Register</button>
    </EditForm>
</div>

@code {
    private RegisterRequest model = new();
    private string? error;
    private bool busy;

    [Inject]
    private AuthService Auth { get; set; } = default!;

    [Inject]
    private NavigationManager Nav { get; set; } = default!;

    private async Task Submit()
    {
        busy = true;
        error = null;
        try
        {
            var result = await Auth.RegisterAsync(model);
            if (result is null)
            {
                error = "Registration failed. Check the details and try again.";
                return;
            }
            Nav.NavigateTo("");
        }
        finally
        {
            busy = false;
        }
    }
}
