@page "/racers/{Id:int}"
@attribute [Authorize]
@inject ApiClient Api

@if (racer is null)
{
    <p>Loading racer...</p>
}
else
{
    <h1>@racer.Name @if (racer.IsRetired)
    {
        <span class="badge">Retired</span>
    }</h1>
    <p>
        @racer.Sex &middot; @racer.AgeYears years &middot; @racer.WeightKg.ToString("0.0") kg
        @if (!string.IsNullOrEmpty(racer.Breed))
        {
            <span>&middot; @racer.Breed</span>
        }
        @if (!string.IsNullOrEmpty(racer.Color))
        {
            <span>&middot; @racer.Color</span>
        }
        @if (!string.IsNullOrEmpty(racer.MicrochipNumber))
        {
            <span>&middot; Chip @racer.MicrochipNumber</span>
        }
    </p>
    <p>
        Stable: <strong>@racer.StableName</strong>
        @if (!string.IsNullOrEmpty(racer.TrainerName))
        {
            <span>&middot; Trainer: @racer.TrainerName</span>
        }
        @if (!string.IsNullOrEmpty(racer.HandlerName))
        {
            <span>&middot; Handler: @racer.HandlerName</span>
        }
    </p>
    <p>
        @if (!string.IsNullOrEmpty(racer.TeamName))
        {
            <span>Team: <strong>@racer.TeamName</strong> &middot;</span>
        }
        <span>Effective from @racer.StartDate.ToString("dd MMM yyyy HH:mm") UTC</span>
        @if (racer.EndDate.HasValue)
        {
            <span>&middot; Superseded @racer.EndDate.Value.ToString("dd MMM yyyy HH:mm") UTC</span>
        }
    </p>

    <AuthorizeView Context="auth" Roles="TrackAdmin,StableAdmin">
        @if (canManage)
        {
            <div class="card">
                <h3>Sharing</h3>
                <p>Grant other teams or users access to this racer: read, write, or full control.</p>
                @if (shareError is not null)
                {
                    <div class="alert-error">@shareError</div>
                }
                @if (shares.Count > 0)
                {
                    <table>
                        <thead><tr><th>Shared with</th><th>Permission</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var share in shares)
                            {
                                <tr>
                                    <td>@(share.ToTeamName ?? share.ToPersonName)</td>
                                    <td>@share.Permission</td>
                                    <td><button class="secondary" @onclick="() => RevokeShare(share.Id)">Revoke</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>Not shared with anyone else.</p>
                }

                <h4>Grant access</h4>
                <div class="form-grid">
                    <div>
                        <label>Team</label>
                        <select @bind="shareTeamId">
                            <option value="0">(none)</option>
                            @foreach (var team in allTeams)
                            {
                                <option value="@team.Id">@team.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label>User</label>
                        <select @bind="sharePersonId">
                            <option value="0">(none)</option>
                            @foreach (var user in users.Where(u => u.PersonId.HasValue))
                            {
                                <option value="@user.PersonId.Value">@user.FullName (@user.Email)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label>Permission</label>
                        <select @bind="sharePermission">
                            <option value="@SharePermission.Read">Read</option>
                            <option value="@SharePermission.Write">Write</option>
                            <option value="@SharePermission.All">All</option>
                        </select>
                    </div>
                </div>
                <button @onclick="GrantShare">Grant</button>
            </div>
        }
    </AuthorizeView>

    <AuthorizeView Context="auth" Roles="StableAdmin">
        @if (canManage)
        {
            <div class="card">
                <h3>Availability flags</h3>
                <p>Tell the track which meetings this racer can enter. The track can only enter racers flagged available.</p>
                @if (availabilityError is not null)
                {
                    <div class="alert-error">@availabilityError</div>
                }
                <table>
                    <thead>
                        <tr><th>Racetrack</th><th>Available</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var track in tracks)
                        {
                            var flag = racer.Availabilities.FirstOrDefault(a => a.RacetrackId == track.Id);
                            var isAvailable = flag?.IsAvailable ?? false;
                            <tr>
                                <td>@track.Name</td>
                                <td>
                                    @if (isAvailable)
                                    {
                                        <span class="badge ok">Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge">Not flagged</span>
                                    }
                                </td>
                                <td>
                                    <button class="secondary" @onclick="() => ToggleAvailability(track.Id, !isAvailable)">
                                        @(isAvailable ? "Withdraw" : "Make available")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </AuthorizeView>

    <div class="card">
        <h3>Owners</h3>
        @if (racer.Owners.Count == 0)
        {
            <p>No owners recorded.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Owner</th><th>Share</th></tr></thead>
                <tbody>
                    @foreach (var owner in racer.Owners)
                    {
                        <tr>
                            <td>@owner.OwnerName</td>
                            <td>@owner.SharePercent.ToString("0.#")%</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <AuthorizeView Context="auth" Roles="Vet,Trainer,StableAdmin">
        <div class="card">
            <h3>Record injury</h3>
            @if (injuryError is not null)
            {
                <div class="alert-error">@injuryError</div>
            }
            <EditForm Model="injuryRequest" OnValidSubmit="CreateInjury">
                <DataAnnotationsValidator />
                <div class="form-grid">
                    <div>
                        <label>Description</label>
                        <InputText @bind-Value="injuryRequest.Description" />
                    </div>
                    <div>
                        <label>Body part</label>
                        <InputText @bind-Value="injuryRequest.BodyPart" />
                    </div>
                    <div>
                        <label>Severity</label>
                        <InputSelect @bind-Value="injuryRequest.Severity">
                            <option value="@InjurySeverity.Minor">Minor</option>
                            <option value="@InjurySeverity.Moderate">Moderate</option>
                            <option value="@InjurySeverity.Severe">Severe</option>
                        </InputSelect>
                    </div>
                </div>
                <button type="submit">Record injury</button>
            </EditForm>
        </div>
    </AuthorizeView>

    <div class="card">
        <h3>Injuries &amp; treatments</h3>
        @if (racer.Injuries.Count == 0)
        {
            <p>No injuries recorded.</p>
        }
        else
        {
            @foreach (var injury in racer.Injuries)
            {
                <h4>@injury.DateReported.ToString("dd MMM yyyy") &mdash; @injury.Description <span class="badge">@injury.Severity</span> <span class="badge">@injury.Status</span></h4>
                @if (!string.IsNullOrEmpty(injury.BodyPart))
                {
                    <p>Affected: @injury.BodyPart @(injury.ReportedByName is null ? "" : $"(reported by {injury.ReportedByName})")</p>
                }
                @if (injury.Treatments.Count > 0)
                {
                    <table>
                        <thead><tr><th>Date</th><th>Treatment</th><th>Medication</th><th>Dosage</th><th>Withdrawal (days)</th><th>Vet</th></tr></thead>
                        <tbody>
                            @foreach (var treatment in injury.Treatments)
                            {
                                <tr>
                                    <td>@treatment.DateAdministered.ToString("dd MMM yyyy")</td>
                                    <td>@treatment.Description</td>
                                    <td>@treatment.Medication</td>
                                    <td>@treatment.Dosage</td>
                                    <td>@treatment.WithdrawalPeriodDays</td>
                                    <td>@treatment.AdministeredByName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <AuthorizeView Context="auth" Roles="Vet">
                    <button class="secondary" @onclick="() => BeginTreatment(injury)">Record treatment</button>
                    @if (treatmentInjuryId == injury.Id)
                    {
                        <EditForm Model="treatmentRequest" OnValidSubmit="SaveTreatment">
                            <DataAnnotationsValidator />
                            <div class="form-grid">
                                <div>
                                    <label>Date administered</label>
                                    <InputDate Type="InputDateType.Date" @bind-Value="treatmentRequest.DateAdministered" />
                                </div>
                                <div>
                                    <label>Description</label>
                                    <InputText @bind-Value="treatmentRequest.Description" />
                                </div>
                                <div>
                                    <label>Medication</label>
                                    <InputText @bind-Value="treatmentRequest.Medication" />
                                </div>
                                <div>
                                    <label>Dosage</label>
                                    <InputText @bind-Value="treatmentRequest.Dosage" />
                                </div>
                                <div>
                                    <label>Withdrawal period (days)</label>
                                    <InputNumber @bind-Value="treatmentRequest.WithdrawalPeriodDays" />
                                </div>
                                <div>
                                    <label>Follow-up date</label>
                                    <InputDate Type="InputDateType.Date" @bind-Value="treatmentRequest.FollowUpDate" />
                                </div>
                            </div>
                            <button type="submit">Save treatment</button>
                            <button type="button" class="secondary" @onclick="() => treatmentInjuryId = null">Cancel</button>
                        </EditForm>
                    }
                </AuthorizeView>
            }
        }
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private RacerDetailDto? racer;
    private List<RacetrackDto> tracks = new();
    private bool canManage;
    private string? availabilityError;

    private List<RecordShareDto> shares = new();
    private List<TeamDto> allTeams = new();
    private List<UserDto> users = new();
    private int shareTeamId;
    private int sharePersonId;
    private SharePermission sharePermission = SharePermission.Read;
    private string? shareError;

    private CreateInjuryRequest injuryRequest = new();
    private string? injuryError;

    private int? treatmentInjuryId;
    private CreateTreatmentRequest treatmentRequest = new();
    private string? treatmentError;

    [Inject]
    private AuthenticationStateProvider AuthState { get; set; } = default!;

    [Inject]
    private NavigationManager Nav { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        canManage = authState.User.IsInRole(AppRoles.StableAdmin) || authState.User.IsInRole(AppRoles.TrackAdmin);

        tracks = await Api.GetRacetracksAsync();
        racer = await Api.GetRacerAsync(Id);
        if (racer is null)
        {
            Nav.NavigateTo("racers");
            return;
        }

        if (canManage)
        {
            try
            {
                allTeams = await Api.GetTeamsAsync();
                users = await Api.GetUsersAsync();
                shares = await Api.GetSharesAsync(nameof(Racer), racer.Key);
            }
            catch (ApiError ex)
            {
                shareError = ex.Message;
            }
        }
    }

    private async Task GrantShare()
    {
        if (racer is null || (shareTeamId == 0 && sharePersonId == 0))
            return;

        shareError = null;
        try
        {
            await Api.GrantShareAsync(new CreateShareRequest
            {
                EntityType = nameof(Racer),
                EntityKey = racer.Key,
                ToTeamId = shareTeamId == 0 ? null : shareTeamId,
                ToPersonId = sharePersonId == 0 ? null : sharePersonId,
                Permission = sharePermission
            });
            shares = await Api.GetSharesAsync(nameof(Racer), racer.Key);
        }
        catch (ApiError ex)
        {
            shareError = ex.Message;
        }
    }

    private async Task RevokeShare(int shareId)
    {
        if (racer is null)
            return;

        shareError = null;
        try
        {
            await Api.RevokeShareAsync(shareId);
            shares = await Api.GetSharesAsync(nameof(Racer), racer.Key);
        }
        catch (ApiError ex)
        {
            shareError = ex.Message;
        }
    }

    private async Task ToggleAvailability(int racetrackId, bool isAvailable)
    {
        availabilityError = null;
        try
        {
            await Api.SetAvailabilityAsync(new SetAvailabilityRequest
            {
                RacerId = Id,
                RacetrackId = racetrackId,
                IsAvailable = isAvailable
            });
            racer = await Api.GetRacerAsync(Id);
        }
        catch (ApiError ex)
        {
            availabilityError = ex.Message;
        }
    }

    private async Task CreateInjury()
    {
        injuryError = null;
        injuryRequest.RacerId = Id;
        try
        {
            await Api.CreateInjuryAsync(injuryRequest);
            injuryRequest = new CreateInjuryRequest { RacerId = Id };
            racer = await Api.GetRacerAsync(Id);
        }
        catch (ApiError ex)
        {
            injuryError = ex.Message;
        }
    }

    private void BeginTreatment(InjuryDto injury)
    {
        treatmentInjuryId = injury.Id;
        treatmentRequest = new CreateTreatmentRequest { InjuryId = injury.Id };
        treatmentError = null;
    }

    private async Task SaveTreatment()
    {
        try
        {
            await Api.CreateTreatmentAsync(treatmentRequest);
            treatmentInjuryId = null;
            racer = await Api.GetRacerAsync(Id);
        }
        catch (ApiError ex)
        {
            treatmentError = ex.Message;
        }
    }
}
