<mxCell id="note0" value="&lt;b&gt;Roles (ASP.NET Identity, many per user)&lt;/b&gt;&lt;br/&gt;TrackAdmin &amp;middot; StableAdmin &amp;middot; Owner &amp;middot; Trainer&lt;br/&gt;&amp;middot; Handler &amp;middot; Vet &amp;middot; Racegoer&lt;br/&gt;&lt;br/&gt;A Person can hold several roles at once." style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="300" height="110" as="geometry"/></mxCell>
<mxCell id="note1" value="&lt;b&gt;Stable hierarchy&lt;/b&gt;&lt;br/&gt;StableAdmin adds racers to the stable&lt;br/&gt;and creates trainer / handler accounts.&lt;br/&gt;Owners link to racers only (ownership shares)." style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="790" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="note2" value="&lt;b&gt;Availability gate&lt;/b&gt;&lt;br/&gt;StableAdmin flags a racer available per track.&lt;br/&gt;TrackAdmin can only enter racers flagged&lt;br/&gt;available for the meeting&#x27;s racetrack." style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="790" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="note3" value="&lt;b&gt;Transfers&lt;/b&gt;&lt;br/&gt;Racer ownerships can be replaced (sold)&lt;br/&gt;and StableId can be changed (new stable)." style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="700" width="300" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
